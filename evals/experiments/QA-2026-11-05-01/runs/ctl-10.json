  "claims": [
    {
      "title": "Database maintenance traffic exposes CMS data to on-path observers",
      "description": "An attacker able to observe the public-internet-to-hosted-network path intercepts `flow:entity:admin>store:mysql-database>direct-administration`, which carries direct MySQL maintenance for pages, accounts, and comments into `store:mysql-database` with transport encryption stated absent. The attacker can read PII and CMS data in the maintenance session without authenticating to the database. Second-order, captured account and content information can be used to target readers or identify valuable CMS records.",
      "affected_element_ids": [
        "flow:entity:admin>store:mysql-database>direct-administration",
        "entity:admin",
        "store:mysql-database"
      ],
      "verb": "intercept",
      "evidence_refs": [
        "crossing:flow:entity:admin>store:mysql-database>direct-administration",
        "absent:flow:entity:admin>store:mysql-database>direct-administration:encryption_in_transit"
      ],
      "quotes": [],
      "absent_elements": [],
      "sequence": 1,
      "attacker_position": "on-path",
      "severity": {
        "likelihood": "medium",
        "impact": "high",
        "level": "high",
        "justification": "Likelihood is medium because `flow:entity:admin>store:mysql-database>direct-administration` crosses from `boundary:public-internet` and has encryption in transit stated absent, though the attacker must obtain an on-path position. Impact is high because the intercepted direct-database session handles the contents of `store:mysql-database`, including data tagged `pii` and the site's accounts."
      },
      "mitigations": [
        {
          "summary": "Encrypt direct MySQL administration traffic",
          "detail": "Require TLS 1.2+ with verified server certificates for `flow:entity:admin>store:mysql-database>direct-administration`; use mTLS where the database can validate the administrator client."
        },
        {
          "summary": "Constrain administrative network access",
          "detail": "Require administration through a managed jump host or private administrative network rather than arbitrary public-network locations, and restrict database ingress to that path."
        }
      ]
    },
    {
      "title": "Unverified database authentication may expose the CMS corpus through direct administration",
      "description": "`flow:entity:admin>store:mysql-database>direct-administration` permits a connection from `entity:admin` in `boundary:public-internet` directly to `store:mysql-database`, but its `authentication` attribute is unknown. If this unresolved control is absent, weak, or permits overly broad database access, an outside attacker who reaches the same listener can submit MySQL queries and elicit pages, accounts, and comments, including PII, from the store. Second-order, disclosure of the account corpus enables targeted attacks against readers and reveals CMS content outside its intended presentation path. This is conditional on the unknown authentication posture; it does not assert that database authentication is absent.",
      "affected_element_ids": [
        "store:mysql-database",
        "flow:entity:admin>store:mysql-database>direct-administration",
        "entity:admin"
      ],
      "verb": "elicit",
      "evidence_refs": [
        "crossing:flow:entity:admin>store:mysql-database>direct-administration",
        "unknown:flow:entity:admin>store:mysql-database>direct-administration:authentication"
      ],
      "quotes": [],
      "absent_elements": [],
      "sequence": 2,
      "attacker_position": "outside",
      "severity": {
        "likelihood": "medium",
        "impact": "high",
        "level": "high",
        "justification": "Likelihood is medium and conditional because `flow:entity:admin>store:mysql-database>direct-administration` crosses from `boundary:public-internet`, while its authentication is unverified and an attacker must still find it weak or absent. Impact is high because successful direct queries can expose the account-bearing `store:mysql-database`, which is tagged `pii` and contains pages, accounts, and comments."
      },
      "mitigations": [
        {
          "summary": "Verify and enforce database authentication",
          "detail": "Resolve the unknown authentication state on `flow:entity:admin>store:mysql-database>direct-administration` and require individual, strongly authenticated administrative identities with no anonymous or shared access."
        },
        {
          "summary": "Apply least-privilege database authorization",
          "detail": "Give each administrator only the schemas, tables, rows, and operations required for maintenance; separate read-only diagnostics from write administration and audit direct reads."
        }
      ]
    },
    {
      "title": "CMS-to-MySQL traffic may disclose PII if internal transport encryption is absent",
      "description": "`flow:process:web-server>store:mysql-database>cms-data` carries pages, accounts, and comments, including PII, between `process:web-server` and `store:mysql-database`, but its `encryption_in_transit` attribute is unknown. If that unknown resolves to no effective transport protection, an attacker with a foothold on the hosted-network path can intercept CMS database requests and responses and read account-related data. Second-order, observed account and content data can support targeted attacks against readers and reveal information that the HTTPS public page flow does not expose. This is conditional on the unverified transport-control attribute, not an assertion that the internal MySQL link is cleartext.",
      "affected_element_ids": [
        "flow:process:web-server>store:mysql-database>cms-data",
        "process:web-server",
        "store:mysql-database"
      ],
      "verb": "intercept",
      "evidence_refs": [
        "unknown:flow:process:web-server>store:mysql-database>cms-data:encryption_in_transit"
      ],
      "quotes": [],
      "absent_elements": [],
      "sequence": 3,
      "attacker_position": "on-path",
      "severity": {
        "likelihood": "low",
        "impact": "medium",
        "level": "low",
        "justification": "Likelihood is low and conditional because the MySQL link remains inside `boundary:hosted-network`, so the attacker needs a network foothold as well as the unverified encryption control to be ineffective. Impact is medium because the flow and `store:mysql-database` are tagged `pii` and carry accounts and comments, but the model does not establish the scale or classification of the database."
      },
      "mitigations": [
        {
          "summary": "Require authenticated encryption on the CMS database connection",
          "detail": "Configure TLS 1.2+ for `flow:process:web-server>store:mysql-database>cms-data`, validate the MySQL server certificate, and use mTLS or equivalent workload authentication where supported."
        },
        {
          "summary": "Limit visibility of the hosted-network database path",
          "detail": "Segment database traffic so only `process:web-server` can reach the MySQL listener and prevent packet capture or lateral observation by unrelated hosted-network workloads."
        }
      ]
    },
    {
      "title": "A storage copy may expose MySQL account data if encryption at rest is not enabled",
      "description": "`store:mysql-database` holds pages, accounts, and comments and is tagged `pii`, but its `encryption_at_rest` attribute is unknown. If the store or its operational copies are not encrypted at rest, an attacker who obtains the underlying database media, a snapshot, or another storage-layer copy can read its contents without using the CMS or presenting database credentials. Second-order, the copied account data enables targeting of readers and offline analysis of CMS content. This is conditional on the unresolved at-rest encryption state; it does not claim the database is unencrypted.",
