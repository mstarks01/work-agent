architecture-beta
    group z0(cloud)[Trust zone public internet]
    group z1(cloud)[Trust zone storefront dmz]
    group z2(cloud)[Trust zone core services]
    service n0(internet)[shopper] in z0
    service n1(internet)[card processor] in z0
    service n2(server)[storefront API] in z1
    service n3(server)[order service] in z2
    service n4(database)[orders db] in z2
    service n5(database)[receipt archive] in z2
